# Environment: development, testing, production
ENVIRONMENT=development
PROJECT_NAME="AI Customer Support Platform"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL with pgvector)
# Local: postgresql+psycopg://postgres:postgres@localhost:5432/customer_support_db
# Docker: postgresql+psycopg://postgres:postgres@postgres:5432/customer_support_db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_support_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_TIMEOUT_SECONDS=10

# Security (JWT & Password Hashing for Phase 2)
SECRET_KEY=dev_secret_key_change_in_production_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# Machine Learning & Embeddings (scikit-learn & Sentence Transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CLASSIFIER_ARTIFACTS_DIR=app/ml/artifacts

# LLM Provider Configuration
# Options: mock, gemini, openai
LLM_PROVIDER=mock
LLM_MODEL_NAME=gemini-1.5-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
